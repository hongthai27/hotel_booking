    "qrcode.react": "^4.2.0",
    "react-datepicker": "^9.1.0",
    "react-hook-form": "^7.75.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
